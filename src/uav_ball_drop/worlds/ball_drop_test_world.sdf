<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="ball_drop_world">
    <!-- Rigorous 1ms DART Physics Configuration -->
    <physics name="dart_1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Gazebo Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Balanced Studio Lighting -->
    <light type="directional" name="key_light">
      <cast_shadows>true</cast_shadows>
      <pose>2 -2 6 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.3 -0.9</direction>
    </light>
    
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>-2 2 4 0 0 0</pose>
      <diffuse>0.4 0.4 0.45 1</diffuse>
      <direction>0.3 -0.3 -0.8</direction>
    </light>

    <!-- Clean Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>500000.0</kp>
                <kd>50.0</kd>
              </ode>
            </contact>
            <bounce>
              <restitution_coefficient>0.72</restitution_coefficient>
              <threshold>0.01</threshold>
            </bounce>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.87 0.90 1</ambient>
            <diffuse>0.85 0.87 0.90 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Concentric Precision Bullseye Target -->
    <model name="drop_target">
      <static>true</static>
      <pose>0 0.048 0.0005 0 0 0</pose>
      
      <!-- Outer Ring (Radius 0.75 m) -->
      <link name="outer_ring">
        <visual name="outer_visual">
          <geometry>
            <cylinder>
              <radius>0.75</radius>
              <length>0.001</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.20 0.20 1</ambient>
            <diffuse>0.85 0.20 0.20 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Middle Ring (Radius 0.50 m) -->
      <link name="mid_ring">
        <pose>0 0 0.0005 0 0 0</pose>
        <visual name="mid_visual">
          <geometry>
            <cylinder>
              <radius>0.50</radius>
              <length>0.001</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Inner Ring (Radius 0.25 m) -->
      <link name="inner_ring">
        <pose>0 0 0.0010 0 0 0</pose>
        <visual name="inner_visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.001</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.20 0.20 1</ambient>
            <diffuse>0.85 0.20 0.20 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Center Bullseye Disc (Radius 0.08 m) -->
      <link name="center_disc">
        <pose>0 0 0.0015 0 0 0</pose>
        <visual name="center_visual">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.001</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.85 0.10 1</ambient>
            <diffuse>0.95 0.85 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Minimalist Drone Carbon Fiber Payload Rails (Altitude: 1.80m) -->
    <model name="uav_payload_rails">
      <static>true</static>
      <pose>0 0 1.80 0 0 0</pose>
      <link name="rails_link">
        <!-- Rail 1 -->
        <visual name="rail_1">
          <pose>0 0.08 0.015 0 1.5708 0</pose>
          <geometry>
            <cylinder>
              <radius>0.006</radius>
              <length>0.36</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <!-- Rail 2 -->
        <visual name="rail_2">
          <pose>0 -0.08 0.015 0 1.5708 0</pose>
          <geometry>
            <cylinder>
              <radius>0.006</radius>
              <length>0.36</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <!-- Mounting Crossplate -->
        <visual name="crossplate">
          <pose>0 0 0.008 0 0 0</pose>
          <geometry>
            <box>
              <size>0.18 0.18 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.22 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ball Drop Mechanism Mounted Directly Under the Rails -->
    <include>
      <uri>model://uav_ball_drop_mechanism</uri>
      <name>uav_ball_drop_mechanism</name>
      <pose>0 0 1.80 0 0 0</pose>
    </include>

    <!-- Primary Camera: High-Clarity Trajectory & Mechanism Framing with 3D Depth -->
    <model name="camera_model">
      <static>true</static>
      <!-- Isometric perspective with 3D depth, comfortable headroom, and full ground target -->
      <pose>0.60 -2.30 1.05 0 -0.02 1.84</pose>
      <link name="camera_link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.25</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>30</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <topic>/camera/image</topic>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
