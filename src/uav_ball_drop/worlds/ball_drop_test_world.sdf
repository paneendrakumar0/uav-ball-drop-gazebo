<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="ball_drop_world">
    <!-- Rigorous 1ms DART Physics Configuration -->
    <physics name="dart_1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Gazebo Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Studio Lighting -->
    <light type="directional" name="key_light">
      <cast_shadows>true</cast_shadows>
      <pose>2 -2 5 0 0 0</pose>
      <diffuse>0.82 0.82 0.82 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <direction>-0.35 0.35 -0.87</direction>
    </light>
    
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>-2 2 3 0 0 0</pose>
      <diffuse>0.35 0.35 0.40 1</diffuse>
      <direction>0.35 -0.35 -0.87</direction>
    </light>

    <!-- Professional Slate Testing Floor for High Target Contrast -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>500000.0</kp>
                <kd>50.0</kd>
              </ode>
            </contact>
            <bounce>
              <restitution_coefficient>0.72</restitution_coefficient>
              <threshold>0.01</threshold>
            </bounce>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.22 0.24 0.26 1</ambient>
            <diffuse>0.26 0.28 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- High-Resolution Precision Target Pad Model -->
    <include>
      <uri>model://drop_target</uri>
      <name>drop_target</name>
      <pose>0 0.048 0 0 0 0</pose>
    </include>

    <!-- Minimalist Drone Carbon Fiber Payload Rails (Altitude: 1.50m) -->
    <model name="uav_payload_rails">
      <static>true</static>
      <pose>0 0 1.50 0 0 0</pose>
      <link name="rails_link">
        <!-- Rail 1 -->
        <visual name="rail_1">
          <pose>0 0.08 0.015 0 1.5708 0</pose>
          <geometry>
            <cylinder>
              <radius>0.006</radius>
              <length>0.36</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <!-- Rail 2 -->
        <visual name="rail_2">
          <pose>0 -0.08 0.015 0 1.5708 0</pose>
          <geometry>
            <cylinder>
              <radius>0.006</radius>
              <length>0.36</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <!-- Mounting Plate -->
        <visual name="crossplate">
          <pose>0 0 0.008 0 0 0</pose>
          <geometry>
            <box>
              <size>0.18 0.18 0.006</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.22 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ball Drop Mechanism Mounted Directly Under the Rails -->
    <include>
      <uri>model://uav_ball_drop_mechanism</uri>
      <name>uav_ball_drop_mechanism</name>
      <pose>0 0 1.50 0 0 0</pose>
    </include>

    <!-- Anchor Mechanism Base to Rails -->
    <joint name="rails_to_mechanism_joint" type="fixed">
      <parent>uav_payload_rails::rails_link</parent>
      <child>uav_ball_drop_mechanism::base_link</child>
    </joint>

    <!-- Primary Camera: Calibrated 3D Isometric Vantage Framing -->
    <model name="camera_model">
      <static>true</static>
      <!-- Perfectly centered: mechanism in upper third, full bullseye in lower half with margins -->
      <pose>2.157 -2.109 2.100 0.000 0.497 2.356</pose>
      <link name="camera_link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.2392</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>30</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <topic>/camera/image</topic>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
