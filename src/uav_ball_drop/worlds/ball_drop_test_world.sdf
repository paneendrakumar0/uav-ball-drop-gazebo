<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="ball_drop_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Sim Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane with Precision Drop Target -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bullseye Drop Target (Droniada Competition Style) on the Ground -->
    <model name="drop_target">
      <static>true</static>
      <pose>0 0.048 0.001 0 0 0</pose>
      
      <!-- Outer Red Ring (Radius 1.0 m) -->
      <link name="outer_ring">
        <visual name="outer_visual">
          <geometry>
            <cylinder>
              <radius>1.0</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Middle White Ring (Radius 0.6 m) -->
      <link name="middle_ring">
        <pose>0 0 0.001 0 0 0</pose>
        <visual name="mid_visual">
          <geometry>
            <cylinder>
              <radius>0.6</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Inner Bullseye (Radius 0.25 m) -->
      <link name="bullseye">
        <pose>0 0 0.002 0 0 0</pose>
        <visual name="center_visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Test Stand / Rig Suspending the Mechanism at 2.5m Altitude -->
    <model name="test_stand">
      <static>true</static>
      <pose>0 0 2.5 0 0 0</pose>
      <link name="stand_rig">
        <visual name="crossbar">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry>
            <box>
              <size>0.25 0.25 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.35 1</ambient>
            <diffuse>0.3 0.3 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ball Drop Mechanism Instance Mounted on the Test Stand -->
    <include>
      <uri>model://uav_ball_drop_mechanism</uri>
      <name>uav_ball_drop_mechanism</name>
      <pose>0 0 2.5 0 0 0</pose>
    </include>

  </world>
</sdf>
