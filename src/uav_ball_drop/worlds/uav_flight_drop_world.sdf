<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="uav_flight_world">
    <!-- Rigorous 1ms DART Physics Configuration -->
    <physics name="dart_1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Gazebo Sim Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Studio Lighting -->
    <light type="directional" name="key_light">
      <cast_shadows>true</cast_shadows>
      <pose>3 -3 7 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <direction>-0.35 0.35 -0.87</direction>
    </light>
    
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>-3 3 5 0 0 0</pose>
      <diffuse>0.35 0.35 0.40 1</diffuse>
      <direction>0.35 -0.35 -0.87</direction>
    </light>

    <!-- Professional Slate Testing Arena Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>500000.0</kp>
                <kd>50.0</kd>
              </ode>
            </contact>
            <bounce>
              <restitution_coefficient>0.72</restitution_coefficient>
              <threshold>0.01</threshold>
            </bounce>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.22 0.24 0.26 1</ambient>
            <diffuse>0.26 0.28 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Precision Ground Drop Target Pad -->
    <include>
      <uri>model://drop_target</uri>
      <name>drop_target</name>
      <pose>0 0.048 0 0 0 0</pose>
    </include>

    <!-- Airborne Quadrotor with Integrated Ball Drop Mechanism -->
    <include>
      <uri>model://uav_with_ball_drop</uri>
      <name>uav_with_ball_drop</name>
      <!-- Starts in air ready for autonomous ingress mission -->
      <pose>-2.20 -1.80 2.20 0 0.08 0.68</pose>
    </include>

    <!-- Primary Camera: Dynamic Cinematic Flight & Drop Tracking Vantage -->
    <model name="flight_camera_model">
      <static>true</static>
      <!-- Initial Wide Perspective framing arena, flight path, and bullseye -->
      <pose>3.10 -2.70 2.65 0 0.42 2.45</pose>
      <link name="camera_link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.25</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>50</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <topic>/camera/image</topic>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
