<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="payload_ball">
    <pose>0 0 0 0 0 0</pose>
    <link name="ball_link">
      <inertial>
        <mass>0.045</mass>
        <!-- Sphere inertia I = 2/5 * m * r^2 = 0.4 * 0.045 * 0.02^2 = 7.2e-6 -->
        <inertia>
          <ixx>0.0000072</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0000072</iyy>
          <iyz>0.0</iyz>
          <izz>0.0000072</izz>
        </inertia>
      </inertial>

      <visual name="ball_visual">
        <geometry>
          <mesh>
            <uri>model://payload_ball/meshes/ball.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1.0 0.84 0.0 1.0</ambient>
          <diffuse>1.0 0.84 0.0 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>

      <collision name="ball_collision">
        <geometry>
          <sphere>
            <radius>0.020</radius>
          </sphere>
        </geometry>
        <surface>
          <bounce>
            <restitution_coefficient>0.7</restitution_coefficient>
            <threshold>0.01</threshold>
          </bounce>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.4</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000.0</kp>
              <kd>1.0</kd>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
