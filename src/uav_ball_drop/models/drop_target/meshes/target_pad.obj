# Precision Target Pad
mtllib target_pad.mtl
o TargetPad

# Vertices
v -0.8 -0.8 0.004
v  0.8 -0.8 0.004
v  0.8  0.8 0.004
v -0.8  0.8 0.004
v -0.8 -0.8 0.0
v  0.8 -0.8 0.0
v  0.8  0.8 0.0
v -0.8  0.8 0.0

# Texture coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normals
vn 0.0 0.0 1.0

# Faces (Top face textured)
usemtl TargetTexture
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

# Bottom and side faces
